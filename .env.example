# ============================================================
# BurpNake Konfigurasyonu — .env.example
# Bu dosyayi kopyalayip .env olarak kaydedin: cp .env.example .env
# ============================================================

# === OLLAMA (Birincil — Yerel AI, Veri Disari Cikmaz) ===
# Yerel kurulum: https://ollama.com/download
# Model cekme: ollama pull qwen2.5-coder:14b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_FALLBACK_MODEL=gemma2:9b
# Docker icinde Ollama kullaniyorsaniz (Windows/Mac Docker Desktop):
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# Docker Linux'ta:
# OLLAMA_BASE_URL=http://172.17.0.1:11434

# === GEMINI (Ikincil — Google API) ===
# API Key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# === GEMINI PRO (Ucuncul — Google One aboneleri) ===
GEMINI_PRO_ENABLED=false
GEMINI_PRO_MODEL=gemini-1.5-pro

# === G4F (Yedek — Ucretsiz LLM Provider) ===
G4F_ENABLED=true

# === UYGULAMA AYARLARI ===
# Dikkat: Docker kullaniyorsaniz APP_HOST=0.0.0.0 olmali
APP_HOST=0.0.0.0
APP_PORT=8899
# DEBUG=true gelistirme icin hot-reload'u aktiflestirir
DEBUG=false
